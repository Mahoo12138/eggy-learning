# 复制为 .env.local 后运行 node server.mjs；外部环境变量优先。
# 此配置用于 Git 历史分类，不会设置或改写 Git 作者。
LEARNER_GIT_EMAIL=mahoo-pig@qq.com
HOST=127.0.0.1
PORT=3000

# ── C 代码运行器 ────────────────────────────────────────────────
# auto   先在本机编译运行；本机缺少 clang / sandbox-exec 时改用在线服务（默认）
# local  只用本机：macOS 的 /usr/bin/clang + /usr/bin/sandbox-exec
# remote 只用在线服务：不需要本机工具链，适合 Linux 服务器或 Windows
# C_RUNNER_PROVIDER=auto

# 在线服务：wandbox（免密钥公共实例）| judge0 | piston（自建实例推荐）
# C_RUNNER_REMOTE_KIND=wandbox
# C_RUNNER_REMOTE_URL=https://wandbox.org/api/compile.json
# C_RUNNER_REMOTE_COMPILER=gcc-head-c
# judge0 的语言编号：50 = C (GCC 9.2.0)，103 = C (GCC 14.1.0)
# C_RUNNER_REMOTE_LANGUAGE_ID=50
# 自建 Piston 开启白名单时需要令牌
# C_RUNNER_REMOTE_TOKEN=
# 单次在线往返的硬上限（毫秒）。公共实例一次实测 4–7 秒，排队时更久，
# 时限过短会把"服务繁忙"误报成"程序死循环"。
# C_RUNNER_REMOTE_TIMEOUT_MS=12000
# C_RUNNER_REMOTE_RETRIES=1

# 本机执行参数
# C_RUNNER_CLANG=/usr/bin/clang
# C_RUNNER_SANDBOX=/usr/bin/sandbox-exec
# C_RUNNER_RUN_TIMEOUT_MS=3000
# 在线结果的复用时间窗（毫秒），0 表示不复用
# C_RUNNER_CACHE_TTL_MS=60000
