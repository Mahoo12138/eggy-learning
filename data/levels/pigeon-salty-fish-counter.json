{
  "schemaVersion": 2,
  "id": "pigeon-salty-fish-counter",
  "version": 1,
  "activityType": "interactive-lesson",
  "rankId": "pigeon",
  "subrankId": "pigeon-iii",
  "sequence": 1,
  "title": "咸鱼还剩几次",
  "estimatedMinutes": 18,
  "prerequisiteLevelIds": [
    "quail-opening-boss"
  ],
  "scene": {
    "locationId": "blind-box-store",
    "propIds": [
      "salty-fish"
    ],
    "intro": "盲盒商店体验台上的咸鱼最多能挥三次，屏幕必须实时显示剩余次数。",
    "success": "体验台的咸鱼次数标牌与实际使用完全一致。"
  },
  "objectives": [
    "理解变量保存可变化的数据",
    "使用减法表达状态变化"
  ],
  "teachingLoop": [
    "predict",
    "run-observe",
    "explain",
    "short-edit",
    "independent-variation"
  ],
  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "uses 从 3 开始，执行一次 uses = uses - 1 后是多少？",
      "interaction": {
        "kind": "number",
        "min": 0,
        "max": 9
      },
      "evaluator": {
        "kind": "number-exact",
        "expected": 2
      },
      "feedback": {
        "correct": "变量 uses 保存了更新后的 2。",
        "incorrect": "先保留你的预测，再运行程序观察真实结果；预测错误不会扣除任何奖励。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "c17-console",
      "prompt": "运行并观察变量值如何改变体验台上的次数标牌。",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int uses = 3;\n  uses = uses - 1;\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
      },
      "stdin": "",
      "evaluator": {
        "kind": "stdout-exact",
        "expected": "剩余2次\n"
      },
      "visualizer": {
        "kind": "counter",
        "target": "salty-fish",
        "valuePattern": "剩余(\\d+)次"
      },
      "observationPrompt": "赋值前后的 uses 分别是多少？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "为什么等号右边使用旧值 3，而执行后 uses 保存的是 2？",
      "referencePoints": [
        "先计算右侧表达式",
        "再把结果写回左侧变量"
      ],
      "answerPolicy": {
        "minimumCharacters": 8,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "再挥一次咸鱼，让屏幕显示剩余 1 次。",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int uses = 3;\n  uses = uses - 1;\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "剩余1次\n"
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "当前程序只做了一次递减。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "在输出前再更新一次 uses。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "两次挥动对应两次减 1。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "在 printf 前增加第二条 uses = uses - 1;。",
        "effect": "当前练习仍可完成；只有独立变式查看完整解法时才需要更换等价变式。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立处理不同初始次数和使用次数。",
      "runtimeId": "c17-console",
      "variantSetId": "pigeon-salty-fish-count-v1",
      "variants": [
        {
          "id": "five-use-three",
          "prompt": "初始 5 次，连续使用 3 次，输出“剩余2次”。",
          "starterFiles": {
            "main.c": "#include <stdio.h>\nint main(void) {\n  int uses = 5;\n  /* 在这里记录三次使用 */\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
          },
          "grader": {
            "kind": "stdout-exact",
            "expected": "剩余2次\n"
          },
          "fullSolution": "#include <stdio.h>\nint main(void) {\n  int uses = 5;\n  uses -= 3;\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
        },
        {
          "id": "four-use-one",
          "prompt": "初始 4 次，使用 1 次，输出“剩余3次”。",
          "starterFiles": {
            "main.c": "#include <stdio.h>\nint main(void) {\n  int uses = 4;\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
          },
          "grader": {
            "kind": "stdout-exact",
            "expected": "剩余3次\n"
          },
          "fullSolution": "#include <stdio.h>\nint main(void) {\n  int uses = 4;\n  uses -= 1;\n  printf(\"剩余%d次\\n\", uses);\n  return 0;\n}\n"
        }
      ],
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "先写出初始值和目标值。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "只修改 uses 的更新语句。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "剩余次数 = 初始次数 - 使用次数。"
        }
      ],
      "fullSolutionPolicy": {
        "availableAfterTier": 3,
        "revealedSolutionDisablesStarForCurrentVariant": true,
        "assignUnusedEquivalentVariant": true
      },
      "starPolicy": {
        "award": 1,
        "firstIndependentClearOnly": true,
        "neverRevoke": true
      }
    }
  ],
  "rewards": {
    "xp": {
      "firstMeaningfulAttempt": 10,
      "firstClear": 20,
      "repeatDailyCap": 5
    },
    "star": {
      "sourceStepId": "independent-variation",
      "amount": 1
    }
  },
  "aiContext": {
    "copyFields": [
      "rankId",
      "title",
      "objectives",
      "currentStep",
      "prompt",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "attemptSummary",
      "viewedHintTiers"
    ],
    "tutorInstruction": "先提问帮助学习者定位原因，不直接给完整答案；若必须展示完整答案，请提醒学习者返回后完成新的等价变式。"
  }
}
