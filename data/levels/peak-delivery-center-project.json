        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 map 查询和修改接口。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "读取与插入应使用不同接口，避免查询产生副作用。"
        }
      ],
      "checkpoint": {
        "kind": "independent-change",
        "task": "独立增加订单校验并拒绝未知道具。",
        "evidence": "单元测试与错误输出",
