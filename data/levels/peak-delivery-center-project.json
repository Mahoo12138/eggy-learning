        "evidence": "两种关店测试与最终统计",
        "automatedChecks": [
          "reject-after-close",
          "drain-policy",
          "cancel-policy",
          "all-joined"
        ],
        "selfChecks": [],
        "awardsStar": true
      },
      "laterReencounter": "Boss 不预告关店发生时刻。"
    }
