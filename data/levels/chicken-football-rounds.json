{
  "schemaVersion": 2,
  "id": "chicken-football-rounds",
  "version": 3,
  "activityType": "interactive-lesson",
  "rankId": "chicken",
  "subrankId": "chicken-i",
  "sequence": 3,
  "title": "用权限、重定向与管道处理系统状态",
  "estimatedMinutes": 25,
  "prerequisiteLevelIds": [
    "chicken-bomb-boundary"
  ],
  "scene": {
    "locationId": "football-field",
    "propIds": [
      "bouncy-ball"
    ],
    "intro": "通过可运行示例逐步掌握“用权限、重定向与管道处理系统状态”。",
    "success": "能够独立完成“用权限、重定向与管道处理系统状态”的等价任务并解释关键原理。"
  },
  "objectives": [
    "读懂 rwx 权限与三位八进制模式，并用 chmod 修改练习文件权限",
    "组合标准输入、重定向、管道、grep、ps 与 kill 完成可复现排查"
  ],
  "teachingLoop": [
    "predict",
    "run-observe",
    "explain",
    "short-edit",
    "independent-variation"
  ],
  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "权限 640 表示所有者、同组用户、其他用户分别拥有什么权限？",
      "interaction": {
        "kind": "mapping",
        "fields": [
          "owner",
          "group",
          "other"
        ]
      },
      "evaluator": {
        "kind": "mapping-exact",
        "expected": {
          "owner": "rw-",
          "group": "r--",
          "other": "---"
        }
      },
      "feedback": {
        "correct": "三组都使用标准 rwx 三字符写法，640 即 rw-、r--、---。",
        "incorrect": "每一组都写成三位：6=rw-，4=r--，0=---。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "linux-shell-sim",
      "prompt": "先用 > 覆盖创建报告，再用 >> 追加一行；随后修改权限，并用管道筛选日志。",
      "starterFiles": {
        "session.sh": "echo first > report.txt\necho second >> report.txt\ncat report.txt\nchmod 640 report.txt\nstat -c %a report.txt\ncat /var/log/app.log | grep ERROR\n"
      },
      "stdin": "",
      "evaluator": {
        "kind": "stdout-exact",
        "expected": "first\nsecond\n640\nERROR sensor\nERROR timeout\n"
      },
      "visualizer": {
        "kind": "terminal-transcript",
        "target": "execution-trace",
        "tokenMap": {}
      },
      "observationPrompt": "为什么报告里同时有 first 和 second？把第二个 >> 改为 > 会发生什么？640 的三组 rwx 各是什么？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "解释 640 的三组权限、> 与 >> 的差别、管道如何连接两个进程，以及 ps/kill 为什么通常先查 PID 再操作。",
      "referencePoints": [
        "权限位分为所有者、组、其他人",
        "> 覆盖，>> 追加",
        "管道把左侧标准输出交给右侧标准输入",
        "PID 标识一次具体运行"
      ],
      "answerPolicy": {
        "minimumCharacters": 28,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "脚本应先显示 logger，终止 logger，再证明 editor 仍在运行。修复错误的 PID 和最后筛选目标。",
      "runtimeId": "linux-shell-sim",
      "starterFiles": {
        "session.sh": "ps | grep logger\nkill 205\nps | grep logger\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "318 logger\n205 editor\n",
        "requirements": {
          "commands": [
            "ps",
            "grep",
            "kill"
          ],
          "commandSequence": [
            "ps",
            "grep",
            "kill",
            "ps",
            "grep"
          ],
          "absentProcesses": [
            318
          ],
          "presentProcesses": [
            205
          ],
          "commandEvidence": [
            {
              "command": "grep",
              "args": [
                "logger"
              ],
              "pipedFrom": "ps",
              "visibleOutput": true
            },
            {
              "command": "kill",
              "args": [
                "318"
              ]
            },
            {
              "command": "grep",
              "args": [
                "editor"
              ],
              "pipedFrom": "ps",
              "visibleOutput": true
            }
          ]
        }
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "第一行显示的 PID 才是应终止的目标。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 kill 的数字和第二次 grep 的名称。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "终止 318，再用 ps | grep editor 证明 205 仍在。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "ps | grep logger\nkill 318\nps | grep editor",
        "effect": "当前练习仍可完成；若在独立变式查看完整解法，系统会改派一道未见过的等价题。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立组合输入、文件、重定向和管道；用不同日志输入验证。",
      "runtimeId": "linux-shell-sim",
      "variantSetId": "chicken-linux-pipes-v3",
      "variants": [
        {
          "id": "filter-errors",
          "prompt": "把标准输入保存为 input.txt，筛选 ERROR 到 errors.txt，设为 640；先输出权限和错误行数，再输出全部错误行。",
          "starterFiles": {
            "session.sh": "cat > input.txt\n"
          },
          "grader": {
            "kind": "stdin-stdout-cases",
            "requirements": {
              "commands": [
                "cat",
                "grep",
                "chmod",
                "stat",
                "wc"
              ],
              "commandSequence": [
                "cat",
                "cat",
                "grep",
                "chmod",
                "stat",
                "wc",
                "cat"
              ],
              "commandEvidence": [
                {
                  "command": "cat",
                  "args": [],
                  "redirect": ">",
                  "redirectPath": "/home/learner/input.txt"
                },
                {
                  "command": "grep",
                  "args": [
                    "ERROR"
                  ],
                  "pipedFrom": "cat",
                  "redirect": ">",
                  "redirectPath": "/home/learner/errors.txt"
                },
                {
                  "command": "chmod",
                  "args": [
                    "640",
                    "errors.txt"
                  ]
                },
                {
                  "command": "stat",
                  "args": [
                    "-c",
                    "%a",
                    "errors.txt"
                  ],
                  "visibleOutput": true
                },
                {
                  "command": "wc",
                  "args": [
                    "-l",
                    "errors.txt"
                  ],
                  "visibleOutput": true
                },
                {
                  "command": "cat",
                  "args": [
                    "errors.txt"
                  ],
                  "visibleOutput": true
                }
              ]
            },
            "cases": [
              {
                "stdin": "INFO boot\nERROR sensor\nERROR timeout\n",
                "stdout": "640\n2\nERROR sensor\nERROR timeout\n",
                "requirements": {
                  "files": {
                    "/home/learner/errors.txt": {
                      "mode": "640",
                      "content": "ERROR sensor\nERROR timeout\n"
                    }
                  }
                }
              },
              {
                "stdin": "INFO only\n",
                "stdout": "640\n0\n",
                "requirements": {
                  "files": {
                    "/home/learner/errors.txt": {
                      "mode": "640",
                      "content": ""
                    }
                  }
                }
              }
            ]
          },
          "fullSolution": "cat > input.txt\ncat input.txt | grep ERROR > errors.txt\nchmod 640 errors.txt\nstat -c %a errors.txt\nwc -l errors.txt\ncat errors.txt"
        },
        {
          "id": "first-warnings",
          "prompt": "把标准输入保存为 input.txt，不区分大小写筛选 warning，取前两条覆盖写入 report.txt，再追加 reviewed；设为 640 后输出权限和报告。",
          "starterFiles": {
            "session.sh": "cat > input.txt\n"
          },
          "grader": {
            "kind": "stdin-stdout-cases",
            "requirements": {
              "commands": [
                "cat",
                "grep",
                "head",
                "echo",
                "chmod",
                "stat"
              ],
              "commandSequence": [
                "cat",
                "cat",
                "grep",
                "head",
                "echo",
                "chmod",
                "stat",
                "cat"
              ],
              "commandEvidence": [
                {
                  "command": "cat",
                  "args": [],
                  "redirect": ">",
                  "redirectPath": "/home/learner/input.txt"
                },
                {
                  "command": "grep",
                  "args": [
                    "-i",
                    "warning"
                  ],
                  "pipedFrom": "cat",
                  "pipedTo": "head"
                },
                {
                  "command": "head",
                  "args": [
                    "-n",
                    "2"
                  ],
                  "pipedFrom": "grep",
                  "redirect": ">",
                  "redirectPath": "/home/learner/report.txt"
                },
                {
                  "command": "echo",
                  "args": [
                    "reviewed"
                  ],
                  "redirect": ">>",
                  "redirectPath": "/home/learner/report.txt"
                },
                {
                  "command": "chmod",
                  "args": [
                    "640",
                    "report.txt"
                  ]
                },
                {
                  "command": "stat",
                  "args": [
                    "-c",
                    "%a",
                    "report.txt"
                  ],
                  "visibleOutput": true
                },
                {
                  "command": "cat",
                  "args": [
                    "report.txt"
                  ],
                  "visibleOutput": true
                }
              ]
            },
            "cases": [
              {
                "stdin": "warning disk\nINFO ok\nWARNING cpu\nWarning net\n",
                "stdout": "640\nwarning disk\nWARNING cpu\nreviewed\n",
                "requirements": {
                  "files": {
                    "/home/learner/report.txt": {
                      "mode": "640",
                      "content": "warning disk\nWARNING cpu\nreviewed\n"
                    }
                  }
                }
              },
              {
                "stdin": "INFO ok\n",
                "stdout": "640\nreviewed\n",
                "requirements": {
                  "files": {
                    "/home/learner/report.txt": {
                      "mode": "640",
                      "content": "reviewed\n"
                    }
                  }
                }
              }
            ]
          },
          "fullSolution": "cat > input.txt\ncat input.txt | grep -i warning | head -n 2 > report.txt\necho reviewed >> report.txt\nchmod 640 report.txt\nstat -c %a report.txt\ncat report.txt"
        }
      ],
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "先分别验证保存、筛选、覆盖/追加、权限和最终读取。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "确认 > 创建结果文件，>> 只追加，chmod 后用 stat 验证。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "cat 读取 stdin；grep/head 组成管道；chmod 640；stat -c %a。"
        }
      ],
      "fullSolutionPolicy": {
        "availableAfterTier": 3,
        "revealedSolutionDisablesStarForCurrentVariant": true,
        "assignUnusedEquivalentVariant": true
      },
      "starPolicy": {
        "award": 1,
        "firstIndependentClearOnly": true,
        "neverRevoke": true
      }
    }
  ],
  "rewards": {
    "xp": {
      "firstMeaningfulAttempt": 10,
      "firstClear": 25,
      "repeatDailyCap": 5
    },
    "star": {
      "sourceStepId": "independent-variation",
