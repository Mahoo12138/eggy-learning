{
  "schemaVersion": 2,
  "id": "quail-opening-boss",
  "version": 2,
  "activityType": "rank-boss",
  "rankId": "quail",
  "sequence": 4,
  "title": "程序执行与输入输出诊断",
  "estimatedMinutes": 24,
  "prerequisiteLevelIds": [
    "quail-fountain-sequence",
    "quail-piano-output",
    "quail-opening-broadcast"
  ],
  "scene": {
    "locationId": "central-fountain",
    "propIds": [],
    "intro": "综合追踪函数调用、修复输入检查，并独立完成一段带格式合同的程序。"
  },
  "resumePolicy": {
    "checkpointed": true,
    "resumeAtLastIncompleteCheckpoint": true
  },
  "checkpoints": [
    {
      "id": "predict-show",
      "kind": "prediction",
      "title": "追踪跨函数执行路径",
      "prompt": "程序先在 main 输出“进入 main”，随后调用 read_value；read_value 输出“调用 read_value”并返回 8；main 最后输出“结果:8”。请排列输出顺序。",
      "evaluator": {
        "kind": "exact-order",
        "expected": [
          "进入 main",
          "调用 read_value",
          "结果:8"
        ]
      }
    },
    {
      "id": "repair-broadcast",
      "kind": "code-repair",
      "title": "修复双整数读取与求和",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\n\nint main(void) {\n  int left, right;\n  if (scanf(\"%d\", &left) != 1) {\n    printf(\"input-error\\n\");\n    return 0;\n  }\n  printf(\"sum:%d\\n\", left + right);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "7 5\n",
            "stdout": "sum:12\n"
          },
          {
            "stdin": "7 x\n",
            "stdout": "input-error\n"
          },
          {
            "stdin": "x 5\n",
            "stdout": "input-error\n"
          },
          {
            "stdin": "-4 9\n",
            "stdout": "sum:5\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "两个整数都必须成功赋值，才能计算总和。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 scanf 的格式字符串、参数数量和返回值。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "一次读取两个 %d，并要求返回值等于 2。"
        }
      ]
    },
    {
      "id": "transfer-new-show",
      "kind": "independent-transfer",
      "title": "独立实现输入回显与最大值",
      "prompt": "编写 C 程序读取两个整数。读取失败输出 input-error；成功时先输出 input:a,b，再输出 max:n。相等时 max 输出该值。",
      "runtimeId": "c17-console",
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "3 9\n",
            "stdout": "input:3,9\nmax:9\n"
          },
          {
            "stdin": "8 -2\n",
            "stdout": "input:8,-2\nmax:8\n"
          },
          {
            "stdin": "5 5\n",
            "stdout": "input:5,5\nmax:5\n"
          },
          {
            "stdin": "4 ?\n",
            "stdout": "input-error\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "先把读取失败路径单独处理，再写成功路径。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "成功路径需要两条 printf，最大值可用 if 或条件表达式。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "要求 scanf 返回 2；用 left >= right 选择最大值。"
        }
      ],
      "fullSolutionPolicy": {
        "availableAfterTier": 3,
        "revealedSolutionDisablesStarForCurrentVariant": true,
        "assignUnusedEquivalentVariant": true
      }
    }
  ],
  "completionRule": {
    "allCheckpointsRequired": true,
    "finalCheckpointMustBeIndependent": true,
    "managerApprovalRequired": false
  },
  "rewards": {
    "xp": 80,
    "rankPromotion": true,
    "coreToken": {
      "id": "token-square-start-key",
      "title": "程序追踪徽章",
      "wallCategory": "ability-token"
    },
    "neverRevoke": true
  },
  "aiContext": {
    "copyFields": [
      "title",
      "checkpoint",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "viewedHintTiers"
    ],
    "tutorInstruction": "用问题引导学习者追踪调用、输入与输出；不要代替学习者完成最后的独立检查点。"
  }
}
