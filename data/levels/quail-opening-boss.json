{
  "schemaVersion": 2,
  "id": "quail-opening-boss",
  "version": 3,
  "activityType": "rank-boss",
  "rankId": "quail",
  "sequence": 4,
  "title": "C 基础与流程控制综合检查",
  "estimatedMinutes": 35,
  "prerequisiteLevelIds": [
    "quail-fountain-sequence",
    "quail-piano-output",
    "quail-opening-broadcast"
  ],
  "scene": {
    "locationId": "central-fountain",
    "propIds": [],
    "intro": "综合运用本段能力完成“C 基础与流程控制综合检查”，每一步都要留下可复现结果。"
  },
  "resumePolicy": {
    "checkpointed": true,
    "resumeAtLastIncompleteCheckpoint": true
  },
  "checkpoints": [
    {
      "id": "predict-show",
      "kind": "prediction",
      "title": "推演批量统计状态",
      "prompt": "依次处理 4、-2、7、0；只有正数计入 valid 与 sum，并持续更新 max。填写最终 valid、sum、max。",
      "evaluator": {
        "kind": "object-exact",
        "expected": {
          "valid": 2,
          "sum": 11,
          "max": 7
        }
      }
    },
    {
      "id": "repair-broadcast",
      "kind": "code-repair",
      "title": "修复函数合同、分支与循环边界",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint accepted(int value) { return value >= 0; }\nint main(void) {\n  int n;\n  if (scanf(\"%d\", &n) != 1 || n < 1 || n > 8) return 1;\n  int count = 0, sum = 0;\n  for (int i = 0; i <= n; i++) {\n    int value;\n    if (scanf(\"%d\", &value) != 1) return 1;\n    if (!accepted(value)) { count++; sum += value; }\n  }\n  printf(\"count=%d,sum=%d\\n\", count, sum);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "4\n4 -2 7 0\n",
            "stdout": "count=2,sum=11\n"
          },
          {
            "stdin": "3\n-1 0 -2\n",
            "stdout": "count=0,sum=0\n"
          },
          {
            "stdin": "1\n5\n",
            "stdout": "count=1,sum=5\n"
          }
        ],
        "requirements": {
          "requiredIdentifiers": [
            "for",
            "scanf",
            "accepted",
            "printf"
          ]
        }
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "分别追踪 0、负数与最后一轮：当前函数、分支和循环各自把什么算错了？"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "依次检查 accepted 的边界、if 的真假方向，以及 for 是否恰好读取 n 次。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "只有 value > 0 才接受；接受时才累加；i 应从 0 到 n-1。"
        }
      ]
    },
    {
      "id": "transfer-new-show",
      "kind": "independent-transfer",
      "title": "独立实现命令行数据统计器",
      "prompt": "从零编写程序：读取 n（1–8）与 n 个整数；用函数 accepted 判断 -100..100；只统计有效值，输出 valid、sum、min、max。至少处理全无效输入并输出 valid=0,sum=0。",
      "runtimeId": "c17-console",
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "5\n4 -2 700 7 0\n",
            "stdout": "valid=4,sum=9,min=-2,max=7\n"
          },
          {
            "stdin": "3\n101 -500 800\n",
            "stdout": "valid=0,sum=0\n"
          },
          {
            "stdin": "1\n-100\n",
            "stdout": "valid=1,sum=-100,min=-100,max=-100\n"
          }
        ],
        "requirements": {
          "requiredIdentifiers": [
            "accepted",
            "for",
            "if",
            "scanf",
            "printf"
          ]
        }
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "先定义“第一个有效值出现前”和“出现后”两种状态。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "accepted 只判断范围；main 负责循环与统计。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "用 has_value 标记 min/max 是否已经由真实有效输入初始化。"
        }
      ],
      "fullSolutionPolicy": {
        "revealRequiresNewEquivalentCheckpoint": true
      }
    }
  ],
  "completionRule": {
    "allCheckpointsRequired": true,
    "finalCheckpointMustBeIndependent": true,
    "managerApprovalRequired": false
  },
  "rewards": {
    "xp": 100,
    "rankPromotion": true,
    "coreToken": {
      "id": "token-square-start-key",
      "title": "C 程序通行证",
      "wallCategory": "ability-token"
    },
    "neverRevoke": true
  },
  "aiContext": {
    "copyFields": [
      "title",
      "checkpoint",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "viewedHintTiers"
    ],
    "tutorInstruction": "用问题帮助学习者缩小问题范围；不要替学习者完成最后的独立迁移检查点。"
  }
}
