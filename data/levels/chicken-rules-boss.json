{
  "schemaVersion": 2,
  "id": "chicken-rules-boss",
  "version": 2,
  "activityType": "rank-boss",
  "rankId": "chicken",
  "sequence": 4,
  "title": "条件、循环与函数综合检查",
  "estimatedMinutes": 30,
  "prerequisiteLevelIds": [
    "chicken-teleport-state",
    "chicken-bomb-boundary",
    "chicken-football-rounds"
  ],
  "scene": {
    "locationId": "eggy-park",
    "propIds": [
      "teleport-ball",
      "bomb",
      "spring-board",
      "bouncy-ball"
    ],
    "intro": "连续检查多状态分支、循环边界和函数复用，任何一个环节出错都会改变最终统计。"
  },
  "resumePolicy": {
    "checkpointed": true,
    "resumeAtLastIncompleteCheckpoint": true
  },
  "checkpoints": [
    {
      "id": "predict-paths",
      "kind": "prediction",
      "title": "追踪四种执行路径",
      "prompt": "规则为 0→pending、1→running、2→done、其余→invalid。填写四个输入的输出。",
      "evaluator": {
        "kind": "mapping-exact",
        "expected": {
          "0": "pending",
          "1": "running",
          "2": "done",
          "3": "invalid"
        }
      }
    },
    {
      "id": "repair-loop-boundary",
      "kind": "code-repair",
      "title": "修复少读一次的循环",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint is_valid(int value) { return value >= 10 && value <= 20; }\nint main(void) {\n  int count = 0;\n  for (int i = 0; i < 2; i++) {\n    int value;\n    scanf(\"%d\", &value);\n    count += is_valid(value);\n  }\n  printf(\"valid=%d\\n\", count);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "10\n9\n20\n",
            "stdout": "valid=2\n"
          },
          {
            "stdin": "11\n12\n13\n",
            "stdout": "valid=3\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "程序只消费了前两个输入。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 for 的终止条件。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "i 从 0 开始，i < 3 才会执行三次。"
        }
      ]
    },
    {
      "id": "transfer-item-judge",
      "kind": "independent-transfer",
      "title": "独立组合函数与四轮统计",
      "prompt": "编写 in_range(value)：1–4（含端点）返回 1。读取 4 个整数并输出 count=N。",
      "runtimeId": "c17-console",
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "0\n1\n4\n5\n",
            "stdout": "count=2\n"
          },
          {
            "stdin": "1\n2\n3\n4\n",
            "stdout": "count=4\n"
          },
          {
            "stdin": "-1\n8\n0\n5\n",
            "stdout": "count=0\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "先用 0、1、4、5 检查函数边界。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "函数只处理一个 value；main 循环四次。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "把每次返回的 0 或 1 累加到 count。"
        }
      ],
      "fullSolutionPolicy": {
        "revealRequiresNewEquivalentCheckpoint": true
      }
    }
  ],
  "completionRule": {
    "allCheckpointsRequired": true,
    "finalCheckpointMustBeIndependent": true,
    "managerApprovalRequired": false
  },
  "rewards": {
    "xp": 80,
    "rankPromotion": true,
    "coreToken": {
      "id": "token-golden-referee-whistle",
      "title": "控制流罗盘",
      "wallCategory": "ability-token"
    },
    "neverRevoke": true
  },
  "aiContext": {
    "copyFields": [
      "title",
      "checkpoint",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "viewedHintTiers"
    ],
    "tutorInstruction": "用问题引导学习者解释现象；不要替学习者完成最后的迁移检查点。"
  }
}
