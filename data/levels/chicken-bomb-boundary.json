  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "规则是 distance <= 2，距离正好为 2 时会不会被波及？",
      "interaction": {
        "kind": "single-choice",
        "options": [
          "会",
          "不会",
          "无法判断"
        ]
      },
      "evaluator": {
        "kind": "choice",
        "expectedIndex": 0
      },
      "feedback": {
        "correct": "<= 包含等于边界的情况。",
        "incorrect": "先保留你的预测，再运行程序观察真实结果；预测错误不会扣除任何奖励。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "c17-console",
      "prompt": "分别观察距离 1、2、3 的结果。",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int distance;\n  scanf(\"%d\", &distance);\n  if (distance <= 2) {\n    printf(\"被波及\\n\");\n  } else {\n    printf(\"安全\\n\");\n  }\n  return 0;\n}\n"
      },
      "stdin": "2\n",
      "evaluator": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "1\n",
            "stdout": "被波及\n"
          },
          {
            "stdin": "2\n",
            "stdout": "被波及\n"
          },
          {
            "stdin": "3\n",
            "stdout": "安全\n"
          }
        ]
      },
      "visualizer": {
        "kind": "radius-check",
        "target": "bomb",
        "radius": 2
      },
      "observationPrompt": "哪一个测试最能确认边界是否包含 2？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "为什么只测距离 1 和 3，仍不能确认 distance < 2 与 distance <= 2 的差别？",
      "referencePoints": [
        "两种条件在 1 和 3 上结果相同",
        "必须测试恰好等于 2 的边界值"
      ],
      "answerPolicy": {
        "minimumCharacters": 8,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "加入自身保护：distance 为 0 时输出“自己取消投掷”，1–2 输出“被波及”，其他输出“安全”。",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int distance;\n  scanf(\"%d\", &distance);\n  if (distance <= 2) {\n    printf(\"被波及\\n\");\n  } else {\n    printf(\"安全\\n\");\n  }\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "0\n",
            "stdout": "自己取消投掷\n"
          },
          {
            "stdin": "1\n",
            "stdout": "被波及\n"
          },
          {
            "stdin": "2\n",
            "stdout": "被波及\n"
          },
          {
            "stdin": "3\n",
            "stdout": "安全\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "distance=0 需要比范围判断更早处理。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "在原 if 前增加一个分支。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "按特殊值 0、范围 1–2、其余距离的顺序判断。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "先 if (distance == 0)，再 else if (distance <= 2)，最后 else。",
        "effect": "当前练习仍可完成；只有独立变式查看完整解法时才需要更换等价变式。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立实现另一种范围道具。",
