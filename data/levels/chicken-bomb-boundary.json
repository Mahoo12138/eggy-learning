{
  "schemaVersion": 2,
  "id": "chicken-bomb-boundary",
  "version": 3,
  "activityType": "interactive-lesson",
  "rankId": "chicken",
  "subrankId": "chicken-ii",
  "sequence": 2,
  "title": "在 Linux 目录树中定位与管理文件",
  "estimatedMinutes": 24,
  "prerequisiteLevelIds": [
    "chicken-teleport-state"
  ],
  "scene": {
    "locationId": "eggy-park",
    "propIds": [
      "bomb",
      "smoke-bomb",
      "ink-bomb"
    ],
    "intro": "通过可运行示例逐步掌握“在 Linux 目录树中定位与管理文件”。",
    "success": "能够独立完成“在 Linux 目录树中定位与管理文件”的等价任务并解释关键原理。"
  },
  "objectives": [
    "使用绝对路径、相对路径、点号、双点号和波浪号定位文件",
    "认识 /home、/etc、/var、/tmp、/dev、/proc 的常见职责，并安全执行基础文件操作"
  ],
  "teachingLoop": [
    "predict",
    "run-observe",
    "explain",
    "short-edit",
    "independent-variation"
  ],
  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "当前目录是 /home/learner。要查看 /var/log/app.log，请排列不会依赖猜测的命令。",
      "interaction": {
        "kind": "reorder",
        "items": [
          "pwd",
          "cd /var/log",
          "pwd",
          "ls",
          "cat app.log"
        ]
      },
      "evaluator": {
        "kind": "exact-order",
        "expected": [
          "pwd",
          "cd /var/log",
          "pwd",
          "ls",
          "cat app.log"
        ]
      },
      "feedback": {
        "correct": "绝对路径导航与验证顺序正确。",
        "incorrect": "先确认当前位置，再用绝对路径到达目标目录；到达后用 pwd 和 ls 验证。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "linux-shell-sim",
      "prompt": "观察 ./ 从当前目录出发、.. 返回上级目录，以及相对文件名如何随 cwd 改变。",
      "starterFiles": {
        "session.sh": "pwd\ncd ./work\npwd\ncd ..\npwd\ncat ./tasks.txt\n"
      },
      "stdin": "",
      "evaluator": {
        "kind": "stdout-exact",
        "expected": "/home/learner\n/home/learner/work\n/home/learner\nlearn C\nlearn Linux\n"
      },
      "visualizer": {
        "kind": "terminal-transcript",
        "target": "execution-trace",
        "tokenMap": {}
      },
      "observationPrompt": "./work、.. 和 ./tasks.txt 分别以哪个目录为起点？同一个相对路径为什么会随 cwd 改变含义？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "解释绝对路径与相对路径的解析起点，并说明 /home、/etc、/var、/tmp、/dev、/proc 各自通常放什么。",
      "referencePoints": [
        "绝对路径从根目录开始",
        "相对路径从当前目录开始",
        "/home 放用户数据，/etc 放配置，/var 放变化数据",
        "/dev 与 /proc 暴露设备和内核状态"
      ],
      "answerPolicy": {
        "minimumCharacters": 28,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "脚本进入 ./work 后错误地停在原地。修复它：使用 .. 回到上级目录，输出当前位置并读取 ./tasks.txt。",
      "runtimeId": "linux-shell-sim",
      "starterFiles": {
        "session.sh": "cd ./work\ncd .\npwd\ncat tasks.txt\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "/home/learner\nlearn C\nlearn Linux\n",
        "requirements": {
          "commands": [
            "cd",
            "pwd",
            "cat"
          ],
          "commandSequence": [
            "cd",
            "cd",
            "pwd",
            "cat"
          ],
          "pathForms": [
            "dot",
            "dotdot"
          ],
          "cwd": "/home/learner"
        }
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": ". 与 .. 对当前目录的影响有什么不同？"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查第二条 cd 和 cat 使用的相对路径。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "使用 cd .. 返回 /home/learner，再读取 ./tasks.txt。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "cd ./work\ncd ..\npwd\ncat ./tasks.txt",
        "effect": "当前练习仍可完成；若在独立变式查看完整解法，系统会改派一道未见过的等价题。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立完成一段可验证的目录与文件操作。",
      "runtimeId": "linux-shell-sim",
      "variantSetId": "chicken-linux-paths-v3",
      "variants": [
        {
          "id": "inspect-log-directory",
          "prompt": "进入 /var/log 并输出位置；再用 .. 回到根目录，输出位置并读取 ./etc/hostname。",
          "starterFiles": {
            "session.sh": "pwd\n"
          },
          "grader": {
            "kind": "stdout-exact",
            "expected": "/var/log\n/\neggy-lab\n",
            "requirements": {
              "commands": [
                "cd",
                "pwd",
                "cat"
              ],
              "commandSequence": [
                "cd",
                "pwd",
                "cd",
                "pwd",
                "cat"
              ],
              "pathForms": [
                "dot",
                "dotdot"
              ],
              "cwd": "/"
            }
          },
          "fullSolution": "cd /var/log\npwd\ncd ../..\npwd\ncat ./etc/hostname"
        },
        {
          "id": "organize-work-note",
          "prompt": "从 ~ 出发：创建 /tmp/archive，把 ./work/notes.txt 复制到 /tmp/staging.txt 后移动为 /tmp/archive/notes.txt；创建并删除 /tmp/scratch.txt。最终进入 archive，输出位置、列表和 notes.txt 内容。",
          "starterFiles": {
            "session.sh": "cd ~\n"
          },
          "grader": {
            "kind": "stdout-exact",
            "expected": "/tmp/archive\nnotes.txt\nbuild\nrun\ndebug\n",
            "requirements": {
              "commands": [
                "cd",
                "mkdir",
                "cp",
                "mv",
                "touch",
                "rm",
                "pwd",
                "ls",
                "cat"
              ],
              "commandSequence": [
                "cd",
                "mkdir",
                "cp",
                "mv",
                "touch",
                "rm",
                "cd",
                "pwd",
                "ls",
                "cat"
              ],
              "pathForms": [
                "home",
                "dot"
              ],
              "cwd": "/tmp/archive",
              "files": {
                "/tmp/archive/notes.txt": {
                  "content": "build\nrun\ndebug\n"
                }
              },
              "absentFiles": [
                "/tmp/staging.txt",
                "/tmp/scratch.txt"
              ],
              "commandEvidence": [
                {
                  "command": "mkdir",
                  "args": [
                    "/tmp/archive"
                  ]
                },
                {
                  "command": "cp",
                  "args": [
                    "./work/notes.txt",
                    "/tmp/staging.txt"
                  ]
                },
                {
                  "command": "mv",
                  "args": [
                    "/tmp/staging.txt",
                    "/tmp/archive/notes.txt"
                  ]
                },
                {
                  "command": "touch",
                  "args": [
                    "/tmp/scratch.txt"
                  ]
                },
                {
                  "command": "rm",
                  "args": [
                    "/tmp/scratch.txt"
                  ]
                },
                {
                  "command": "pwd",
                  "args": [],
                  "visibleOutput": true
                },
                {
                  "command": "ls",
                  "args": [],
                  "visibleOutput": true
                },
                {
                  "command": "cat",
                  "args": [
                    "./notes.txt"
                  ],
                  "visibleOutput": true
                }
              ]
            }
          },
          "fullSolution": "cd ~\nmkdir /tmp/archive\ncp ./work/notes.txt /tmp/staging.txt\nmv /tmp/staging.txt /tmp/archive/notes.txt\ntouch /tmp/scratch.txt\nrm /tmp/scratch.txt\ncd /tmp/archive\npwd\nls\ncat ./notes.txt"
        }
      ],
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "每次 cd 后都能用 pwd 证明当前位置；注意路径从哪里开始。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 /、~/、./ 与 ../ 分别以哪里为起点。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "绝对路径从根开始，~ 指向家目录，./ 指当前目录，../ 返回上级。"
        }
      ],
      "fullSolutionPolicy": {
        "availableAfterTier": 3,
        "revealedSolutionDisablesStarForCurrentVariant": true,
        "assignUnusedEquivalentVariant": true
      },
      "starPolicy": {
        "award": 1,
        "firstIndependentClearOnly": true,
        "neverRevoke": true
      }
    }
  ],
