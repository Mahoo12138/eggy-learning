          "starterFiles": {
            "main.c": "#include <stdio.h>\nint main(void) {\n  int distance;\n  scanf(\"%d\", &distance);\n  /* 编写范围规则 */\n  return 0;\n}\n"
          },
          "grader": {
            "kind": "stdin-stdout-cases",
            "cases": [
              {
                "stdin": "0\n",
