          "fullSolution": "#include <stdio.h>\nint main(void) {\n  int distance;\n  scanf(\"%d\", &distance);\n  if (distance == 0) {\n    printf(\"自己也看不清\\n\");\n  } else if (distance <= 3) {\n    printf(\"进入云雾\\n\");\n  } else {\n    printf(\"视野正常\\n\");\n  }\n  return 0;\n}\n"
        },
