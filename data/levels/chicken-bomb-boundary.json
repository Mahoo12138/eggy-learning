{
  "schemaVersion": 2,
  "id": "chicken-bomb-boundary",
  "version": 2,
  "activityType": "interactive-lesson",
  "rankId": "chicken",
  "subrankId": "chicken-ii",
  "sequence": 2,
  "title": "判断数值是否落在闭区间",
  "estimatedMinutes": 22,
  "prerequisiteLevelIds": [
    "chicken-teleport-state"
  ],
  "scene": {
    "locationId": "eggy-park",
    "propIds": [
      "bomb",
      "smoke-bomb",
      "ink-bomb"
    ],
    "intro": "用成组边界值验证闭区间条件，并单独处理不合法的负数输入。",
    "success": "区间内、两个端点、区间外和非法值都得到正确结果。"
  },
  "objectives": [
    "写出同时包含上下界的布尔表达式",
    "用端点内外的测试值区分 <、<=、> 与 >="
  ],
  "teachingLoop": [
    "predict",
    "run-observe",
    "explain",
    "short-edit",
    "independent-variation"
  ],
  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "哪一个条件准确表示 value 位于闭区间 [10, 20]？",
      "interaction": {
        "kind": "single-choice",
        "options": [
          "value >= 10 && value <= 20",
          "value >= 10 || value <= 20",
          "value > 10 && value < 20"
        ]
      },
      "evaluator": {
        "kind": "choice",
        "expectedIndex": 0
      },
      "feedback": {
        "correct": "闭区间同时要求满足下界和上界，并且包含两个端点。",
        "incorrect": "把 9、10、20、21 依次代入三个表达式，找出只接受 10 到 20 的那个。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "c17-console",
      "prompt": "用端点内外四个值运行，观察闭区间条件的结果。",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int value;\n  scanf(\"%d\", &value);\n  if (value >= 10 && value <= 20) puts(\"in\");\n  else puts(\"out\");\n  return 0;\n}\n"
      },
      "stdin": "10\n",
      "evaluator": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "9\n",
            "stdout": "out\n"
          },
          {
            "stdin": "10\n",
            "stdout": "in\n"
          },
          {
            "stdin": "20\n",
            "stdout": "in\n"
          },
          {
            "stdin": "21\n",
            "stdout": "out\n"
          }
        ]
      },
      "visualizer": {
        "kind": "range-check",
        "target": "value",
        "minimum": 10,
        "maximum": 20,
        "inclusive": true
      },
      "observationPrompt": "哪两个输入专门检查了等号是否正确？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "为什么只测试 15 和 30，无法发现把 <= 20 错写成 < 20 的问题？",
      "referencePoints": [
        "15 在两种写法中都通过",
        "30 在两种写法中都不通过",
        "必须测试上界 20 才能区分是否包含端点"
      ],
      "answerPolicy": {
        "minimumCharacters": 16,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "加入输入规则：负数输出 invalid；否则 10–20 输出 in，其余输出 out。",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int value;\n  scanf(\"%d\", &value);\n  if (value >= 10 && value <= 20) puts(\"in\");\n  else puts(\"out\");\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "-1\n",
            "stdout": "invalid\n"
          },
          {
            "stdin": "9\n",
            "stdout": "out\n"
          },
          {
            "stdin": "10\n",
            "stdout": "in\n"
          },
          {
            "stdin": "20\n",
            "stdout": "in\n"
          },
          {
            "stdin": "21\n",
            "stdout": "out\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "负数不能进入普通的区间内外判断。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "把非法值判断放在闭区间判断之前。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "使用 if (value < 0)，再 else if 检查两个边界。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "先处理 value < 0；其余值再用 value >= 10 && value <= 20 判断。",
        "effect": "当前练习仍可完成；只有独立变式查看完整解法时才需要更换等价变式。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立实现另一组带非法值处理的闭区间规则。",
      "runtimeId": "c17-console",
      "variantSetId": "chicken-radius-rule-v1",
      "variants": [
        {
          "id": "smoke-radius-three",
          "prompt": "读取 sample：负数输出 invalid，5–12（含端点）输出 accepted，其余输出 rejected。",
          "starterFiles": {
            "main.c": "#include <stdio.h>\nint main(void) {\n  int sample;\n  scanf(\"%d\", &sample);\n  /* 完成规则 */\n  return 0;\n}\n"
          },
          "grader": {
            "kind": "stdin-stdout-cases",
            "cases": [
              {
                "stdin": "-1\n",
                "stdout": "invalid\n"
              },
              {
                "stdin": "5\n",
                "stdout": "accepted\n"
              },
              {
                "stdin": "12\n",
                "stdout": "accepted\n"
              },
              {
                "stdin": "13\n",
                "stdout": "rejected\n"
              }
            ]
          },
          "fullSolution": "#include <stdio.h>\nint main(void) {\n  int sample;\n  scanf(\"%d\", &sample);\n  if (sample < 0) puts(\"invalid\");\n  else if (sample >= 5 && sample <= 12) puts(\"accepted\");\n  else puts(\"rejected\");\n  return 0;\n}\n"
        },
        {
          "id": "ink-radius-one",
          "prompt": "读取 count：负数输出 invalid，1–100（含端点）输出 valid，其余输出 out-of-range。",
          "starterFiles": {
            "main.c": "#include <stdio.h>\nint main(void) {\n  int count;\n  scanf(\"%d\", &count);\n  /* 完成规则 */\n  return 0;\n}\n"
          },
          "grader": {
            "kind": "stdin-stdout-cases",
            "cases": [
              {
                "stdin": "-2\n",
                "stdout": "invalid\n"
              },
              {
                "stdin": "1\n",
                "stdout": "valid\n"
              },
              {
                "stdin": "100\n",
                "stdout": "valid\n"
              },
              {
                "stdin": "101\n",
                "stdout": "out-of-range\n"
              }
            ]
          },
          "fullSolution": "#include <stdio.h>\nint main(void) {\n  int count;\n  scanf(\"%d\", &count);\n  if (count < 0) puts(\"invalid\");\n  else if (count >= 1 && count <= 100) puts(\"valid\");\n  else puts(\"out-of-range\");\n  return 0;\n}\n"
        }
      ],
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "至少检查非法值、下界、上界和界外值。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "先写非法分支，再写闭区间条件。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "闭区间上下界用 && 连接，并在两个比较中保留等号。"
        }
      ],
      "fullSolutionPolicy": {
        "availableAfterTier": 3,
        "revealedSolutionDisablesStarForCurrentVariant": true,
        "assignUnusedEquivalentVariant": true
      },
      "starPolicy": {
        "award": 1,
        "firstIndependentClearOnly": true,
        "neverRevoke": true
      }
    }
  ],
  "rewards": {
    "xp": {
      "firstMeaningfulAttempt": 10,
      "firstClear": 20,
      "repeatDailyCap": 5
    },
    "star": {
      "sourceStepId": "independent-variation",
      "amount": 1
    }
  },
  "aiContext": {
    "copyFields": [
      "rankId",
