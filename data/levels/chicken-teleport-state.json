{
  "schemaVersion": 2,
  "id": "chicken-teleport-state",
  "version": 3,
  "activityType": "interactive-lesson",
  "rankId": "chicken",
  "subrankId": "chicken-iii",
  "sequence": 1,
  "title": "认识 Linux：内核、Shell 与进程",
  "estimatedMinutes": 22,
  "prerequisiteLevelIds": [
    "pigeon-data-boss"
  ],
  "scene": {
    "locationId": "eggy-park",
    "propIds": [
      "teleport-ball"
    ],
    "intro": "通过可运行示例逐步掌握“认识 Linux：内核、Shell 与进程”。",
    "success": "能够独立完成“认识 Linux：内核、Shell 与进程”的等价任务并解释关键原理。"
  },
  "objectives": [
    "区分 Linux 内核、用户空间、Shell、程序与进程",
    "用 PID、标准输入输出和退出状态解释一条命令从启动到结束的过程"
  ],
  "teachingLoop": [
    "predict",
    "run-observe",
    "explain",
    "short-edit",
    "independent-variation"
  ],
  "steps": [
    {
      "id": "predict",
      "type": "prediction",
      "prompt": "用户在终端输入 ps 后，系统经历 Shell 解析命令、启动进程、内核调度、ps 写标准输出、终端呈现结果、Shell 再次等待输入。请排列顺序。",
      "interaction": {
        "kind": "reorder",
        "items": [
          "Shell 解析命令与参数",
          "Shell 启动 ps 进程",
          "内核调度进程运行",
          "ps 把结果写到终端连接的标准输出",
          "终端呈现字符，Shell 等待 ps 结束后再次显示提示符"
        ]
      },
      "evaluator": {
        "kind": "exact-order",
        "expected": [
          "Shell 解析命令与参数",
          "Shell 启动 ps 进程",
          "内核调度进程运行",
          "ps 把结果写到终端连接的标准输出",
          "终端呈现字符，Shell 等待 ps 结束后再次显示提示符"
        ]
      },
      "feedback": {
        "correct": "顺序正确：Shell 负责解释和启动，内核调度，进程写 stdout，终端负责呈现，Shell 等待后继续交互。",
        "incorrect": "Shell、内核和进程承担不同职责；先解析和启动，内核才有进程可调度。"
      }
    },
    {
      "id": "run-observe",
      "type": "run-observe",
      "runtimeId": "linux-shell-sim",
      "prompt": "在隔离虚拟终端中查看用户、目录和进程，再运行 false 并读取上一条命令的退出状态。",
      "starterFiles": {
        "session.sh": "whoami\npwd\nps\nfalse\necho $?\n"
      },
      "stdin": "",
      "evaluator": {
        "kind": "stdout-exact",
        "expected": "learner\n/home/learner\nPID COMMAND\n101 init\n205 editor\n318 logger\n1\n"
      },
      "visualizer": {
        "kind": "terminal-transcript",
        "target": "execution-trace",
        "tokenMap": {}
      },
      "observationPrompt": "为什么 ps 是一次新的进程？false 没有输出但 echo $? 得到 1，这与退出状态有什么关系？"
    },
    {
      "id": "explain",
      "type": "explanation",
      "prompt": "区分内核、Shell、终端、程序文件和进程；再说明 PID、标准输出与退出状态分别回答什么问题。",
      "referencePoints": [
        "内核管理进程与资源",
        "Shell 解析命令并启动程序",
        "终端呈现进程写入的字符",
        "PID 标识一次运行中的进程",
        "退出状态 0 通常表示成功，非 0 表示失败"
      ],
      "answerPolicy": {
        "minimumCharacters": 28,
        "managerVisible": true
      }
    },
    {
      "id": "short-edit",
      "type": "code-edit",
      "prompt": "修复命令：依次输出当前用户、logger 进程，以及 false 的退出状态 1。",
      "runtimeId": "linux-shell-sim",
      "starterFiles": {
        "session.sh": "whoami\nps | grep editor\nfalse\necho 0\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "learner\n318 logger\n1\n",
        "requirements": {
          "commands": [
            "whoami",
            "ps",
            "grep",
            "false",
            "echo"
          ],
          "commandSequence": [
            "whoami",
            "ps",
            "grep",
            "false",
            "echo"
          ],
          "commandEvidence": [
            {
              "command": "whoami",
              "args": [],
              "visibleOutput": true
            },
            {
              "command": "grep",
              "args": [
                "logger"
              ],
              "pipedFrom": "ps",
              "visibleOutput": true
            },
            {
              "command": "false",
              "args": []
            },
            {
              "command": "echo",
              "args": [
                "$?"
              ],
              "visibleOutput": true,
              "exitStatusExpanded": true
            }
          ]
        }
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "第二行筛选了哪个进程？退出状态从哪里读取？"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 grep 的模式和 echo 的参数。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "使用 ps | grep logger；false 后使用 echo $?。"
        }
      ],
      "fullSolution": {
        "availableAfterTier": 3,
        "text": "whoami\nps | grep logger\nfalse\necho $?",
        "effect": "当前练习仍可完成；若在独立变式查看完整解法，系统会改派一道未见过的等价题。"
      }
    },
    {
      "id": "independent-variation",
      "type": "independent-variation",
      "prompt": "独立组合系统状态命令与管道筛选。",
      "runtimeId": "linux-shell-sim",
      "variantSetId": "chicken-linux-system-v3",
      "variants": [
