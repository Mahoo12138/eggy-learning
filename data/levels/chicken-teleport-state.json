        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "进程筛选需要管道；状态读取必须紧跟在 false 后。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "使用 ps | grep 名称，再用 false 与 echo $?。"
        }
      ],
      "fullSolutionPolicy": {
