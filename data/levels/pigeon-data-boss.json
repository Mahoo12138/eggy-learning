{
  "schemaVersion": 2,
  "id": "pigeon-data-boss",
  "version": 1,
  "activityType": "rank-boss",
  "rankId": "pigeon",
  "sequence": 4,
  "title": "形象与盲盒数据校准",
  "estimatedMinutes": 24,
  "prerequisiteLevelIds": [
    "pigeon-salty-fish-counter",
    "pigeon-shrink-milk-timer",
    "pigeon-blind-box-balance"
  ],
  "scene": {
    "locationId": "blind-box-store",
    "propIds": [
      "salty-fish",
      "shrink-milk",
      "speed-shoes"
    ],
    "intro": "换新店与盲盒商店的数据面板发生错位，需要一次完整校准。"
  },
  "resumePolicy": {
    "checkpointed": true,
    "resumeAtLastIncompleteCheckpoint": true
  },
  "checkpoints": [
    {
      "id": "predict-values",
      "kind": "prediction",
      "title": "追踪三项数据",
      "prompt": "给定 caps=15、price=4、count=2，写出总价与剩余值。",
      "evaluator": {
        "kind": "object-exact",
        "expected": {
          "total": 8,
          "left": 7
        }
      }
    },
    {
      "id": "repair-mixed-fields",
      "kind": "code-repair",
      "title": "修复显示错位",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int size = 50;\n  int seconds = 3;\n  printf(\"体型%d%%，剩余%d秒\\n\", seconds, size);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "体型50%，剩余3秒\n"
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "两个数都存在，但显示位置反了。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "检查 printf 后面的参数顺序。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "第一个 %d 对应 size，第二个对应 seconds。"
        }
      ]
    },
    {
      "id": "transfer-stock-panel",
      "kind": "independent-transfer",
      "title": "独立制作补货面板",
      "prompt": "库存 6 个，补货 5 个，售出 3 个，输出“当前库存8”。",
      "runtimeId": "c17-console",
      "grader": {
        "kind": "stdout-exact",
        "expected": "当前库存8\n"
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "按事件发生顺序写出库存变化。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "用一个 stock 变量连续更新。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "补货做加法，售出做减法。"
        }
      ],
      "fullSolutionPolicy": {
        "revealRequiresNewEquivalentCheckpoint": true
      }
    }
  ],
  "completionRule": {
    "allCheckpointsRequired": true,
    "finalCheckpointMustBeIndependent": true,
    "managerApprovalRequired": false
  },
  "rewards": {
    "xp": 80,
    "rankPromotion": true,
    "coreToken": {
      "id": "token-data-calibration-chip",
      "title": "数据校准芯片",
      "wallCategory": "ability-token"
    },
    "neverRevoke": true
  },
  "aiContext": {
    "copyFields": [
      "title",
      "checkpoint",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "viewedHintTiers"
    ],
    "tutorInstruction": "用问题引导学习者解释现象；不要替学习者完成最后的迁移检查点。"
  }
}
