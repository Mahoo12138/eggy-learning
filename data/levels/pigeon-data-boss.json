{
  "schemaVersion": 2,
  "id": "pigeon-data-boss",
  "version": 2,
  "activityType": "rank-boss",
  "rankId": "pigeon",
  "sequence": 4,
  "title": "数据与表达式综合检查",
  "estimatedMinutes": 30,
  "prerequisiteLevelIds": [
    "pigeon-salty-fish-counter",
    "pigeon-shrink-milk-timer",
    "pigeon-blind-box-balance"
  ],
  "scene": {
    "locationId": "blind-box-store",
    "propIds": [
      "salty-fish",
      "shrink-milk",
      "speed-shoes"
    ],
    "intro": "综合追踪表达式、中间变量和格式化输出，定位数据从哪一步开始偏离。"
  },
  "resumePolicy": {
    "checkpointed": true,
    "resumeAtLastIncompleteCheckpoint": true
  },
  "checkpoints": [
    {
      "id": "predict-values",
      "kind": "prediction",
      "title": "拆解使用量与剩余量",
      "prompt": "limit=50、unit=7、count=4、fee=3。used=unit*count+fee，left=limit-used。写出 used 与 left。",
      "evaluator": {
        "kind": "object-exact",
        "expected": {
          "used": 31,
          "left": 19
        }
      }
    },
    {
      "id": "repair-mixed-fields",
      "kind": "code-repair",
      "title": "修复字段与计算错位",
      "runtimeId": "c17-console",
      "starterFiles": {
        "main.c": "#include <stdio.h>\nint main(void) {\n  int limit = 50;\n  int used = 37;\n  printf(\"used=%d,left=%d\\n\", limit - used, used);\n  return 0;\n}\n"
      },
      "grader": {
        "kind": "stdout-exact",
        "expected": "used=37,left=13\n"
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "两个需要的数都能由现有变量得到，但现在放错了位置。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "第一个 %d 应对应 used；第二个应对应 limit - used。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "不要改 limit 和 used 的初值，只修正 printf 参数。"
        }
      ]
    },
    {
      "id": "transfer-stock-panel",
      "kind": "independent-transfer",
      "title": "独立计算三步库存",
      "prompt": "读取 initial、received、sold，输出 final=initial+received-sold。",
      "runtimeId": "c17-console",
      "grader": {
        "kind": "stdin-stdout-cases",
        "cases": [
          {
            "stdin": "6 5 3\n",
            "stdout": "final=8\n"
          },
          {
            "stdin": "10 0 4\n",
            "stdout": "final=6\n"
          },
          {
            "stdin": "2 8 10\n",
            "stdout": "final=0\n"
          }
        ]
      },
      "hints": [
        {
          "tier": 1,
          "kind": "observation-focus",
          "text": "按事件顺序更新同一个结果。"
        },
        {
          "tier": 2,
          "kind": "code-region",
          "text": "也可以先算 initial + received，再减 sold。"
        },
        {
          "tier": 3,
          "kind": "cause-and-direction",
          "text": "输出格式必须是 final=N，并保留换行。"
        }
      ],
      "fullSolutionPolicy": {
        "revealRequiresNewEquivalentCheckpoint": true
      }
    }
  ],
  "completionRule": {
    "allCheckpointsRequired": true,
    "finalCheckpointMustBeIndependent": true,
    "managerApprovalRequired": false
  },
  "rewards": {
    "xp": 80,
    "rankPromotion": true,
    "coreToken": {
      "id": "token-data-calibration-chip",
      "title": "数据调试芯片",
      "wallCategory": "ability-token"
    },
    "neverRevoke": true
  },
  "aiContext": {
    "copyFields": [
      "title",
      "checkpoint",
      "code",
      "stdin",
      "expectedBehavior",
      "actualResult",
      "viewedHintTiers"
    ],
    "tutorInstruction": "用问题引导学习者解释现象；不要替学习者完成最后的迁移检查点。"
  }
}
